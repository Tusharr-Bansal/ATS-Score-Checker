# Gemini (https://aistudio.google.com/apikey). Without a key the app runs fully offline:
# rule-based extraction + local sentence-transformers embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Skill matching: llm (default with a key: Gemini verdicts + verified resume quotes) or taxonomy
# (offline rules; also the automatic fallback when Gemini is unavailable). MATCH_BATCH_SIZE resumes per call.
# SKILL_MATCHER=llm
# MATCH_BATCH_SIZE=10

# Optional overrides (defaults: "gemini" when a key is set, otherwise "rules" / "local")
# EXTRACTOR=gemini            # gemini | rules
# EMBEDDING_PROVIDER=gemini   # gemini | local

# SQLite for quick local runs; PostgreSQL in docker-compose / production
DATABASE_URL=sqlite:///./atsscore.db
# DATABASE_URL=postgresql://ats:ats@localhost:5432/atsscore

CORS_ORIGINS=*
LLM_CONCURRENCY=4
# Client-side pacing (requests/min). Free tier: Flash-Lite ~10+ RPM / 500 RPD, Flash ~5 RPM / 20 RPD.
# Check your limits on the AI Studio rate-limit page; 0 disables pacing (paid tier).
LLM_RPM=10
LLM_TIMEOUT_MS=120000
# Embedding texts per minute (free tier counts each text; limit 100/min). 0 = unlimited
EMBED_PER_MIN=90

# Scoring weights (sum to 1)
W_SKILLS=0.40
W_SEMANTIC=0.30
W_EXPERIENCE=0.20
W_EDUCATION=0.10
